  "scripts": {
    "copy-plotly": "node -e \"require('fs').copyFileSync('node_modules/plotly.js-gl3d-dist-min/plotly-gl3d.min.js','public/vendor/plotly-gl3d.min.js')\"",
    "predev": "node -e \"require('fs').mkdirSync('public/vendor',{recursive:true})\" && npm run copy-plotly",
    "prebuild": "node -e \"require('fs').mkdirSync('public/vendor',{recursive:true})\" && npm run copy-plotly",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
