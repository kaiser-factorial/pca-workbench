    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "openai": "^7.3.0",
    "papaparse": "^5.5.4",
    "plotly.js-gl3d-dist-min": "^3.7.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-plotly.js": "^4.0.0",
